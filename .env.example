# Copie para `.env` (ignorado pelo git) e ajuste.

# Base da API. Em producao com o proxy same-origin, deixe vazio/omitido.
VITE_API_BASE_URL=http://localhost:8000

# Chave X-API-Key que o phishforge-api exige em TODA rota /api/v1
# (variavel API_KEY do .env da API).
#
# ATENCAO: qualquer variavel VITE_* e embutida no bundle JavaScript e,
# portanto, PUBLICA. Isto e aceitavel SO em desenvolvimento local. Em
# producao a chave nao pode entrar no bundle: use o proxy same-origin
# (ver a issue "Caminho de producao"), que injeta a chave no servidor.
VITE_API_KEY=
